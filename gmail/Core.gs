  const table = rows
    .map((r) => `<tr><td style="padding:5px 12px 5px 0;color:#56635B;white-space:nowrap;vertical-align:top;">${escapeHtml(r[0])}</td><td style="padding:5px 0;color:#18241D;">${escapeHtml(r[1])}</td></tr>`)
    .join("");
