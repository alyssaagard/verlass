<?xml version="1.0" encoding="UTF-8"?>
<!-- Verlass for Microsoft Outlook. By Alyssa I. Agard. https://verlass.alyssaagard.dev -->
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xsi:type="MailApp">
  <Id>bb17164f-3928-4329-9458-1b70d3575dff</Id>
  <Version>2.0.0.0</Version>
  <ProviderName>Alyssa I. Agard</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Verlass"/>
  <Description DefaultValue="A free, open-source help desk for any organization. People send and follow requests from Gmail or Outlook, and the team works its queue in the same place. Your data stays in your own Google or Microsoft 365 account."/>
  <IconUrl DefaultValue="https://verlass.alyssaagard.dev/assets/icons/icon-64.png"/>
  <HighResolutionIconUrl DefaultValue="https://verlass.alyssaagard.dev/assets/icons/icon-128.png"/>
  <SupportUrl DefaultValue="https://verlass.alyssaagard.dev/help/"/>
  <AppDomains>
    <AppDomain>https://verlass.alyssaagard.dev</AppDomain>
    <AppDomain>https://login.microsoftonline.com</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.3"/>
    </Sets>
  </Requirements>
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://verlass.alyssaagard.dev/app/outlook.html"/>
        <RequestedHeight>450</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>
  <Permissions>ReadItem</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
  </Rule>
  <DisableEntityHighlighting>false</DisableEntityHighlighting>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.3">
        <bt:Set Name="Mailbox"/>
      </bt:Sets>
    </Requirements>
    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>
          <ExtensionPoint xsi:type="MessageReadCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="VerlassGroup">
                <Label resid="GroupLabel"/>
                <Control xsi:type="Button" id="VerlassOpen">
                  <Label resid="ButtonLabel"/>
                  <Supertip>
                    <Title resid="ButtonLabel"/>
                    <Description resid="ButtonTip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16"/>
                    <bt:Image size="32" resid="Icon.32"/>
                    <bt:Image size="80" resid="Icon.80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16" DefaultValue="https://verlass.alyssaagard.dev/assets/icons/icon-16.png"/>
        <bt:Image id="Icon.32" DefaultValue="https://verlass.alyssaagard.dev/assets/icons/icon-32.png"/>
        <bt:Image id="Icon.80" DefaultValue="https://verlass.alyssaagard.dev/assets/icons/icon-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Taskpane.Url" DefaultValue="https://verlass.alyssaagard.dev/app/outlook.html"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GroupLabel" DefaultValue="Verlass"/>
        <bt:String id="ButtonLabel" DefaultValue="Help desk"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="ButtonTip" DefaultValue="Send a request to the help desk, follow your requests, and work the team's queue."/>
      </bt:LongStrings>
    </Resources>
    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">
      <Requirements>
        <bt:Sets DefaultMinVersion="1.3">
          <bt:Set Name="Mailbox"/>
        </bt:Sets>
      </Requirements>
      <Hosts>
        <Host xsi:type="MailHost">
        <DesktopFormFactor>
          <ExtensionPoint xsi:type="MessageReadCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="VerlassGroup">
                <Label resid="GroupLabel"/>
                <Control xsi:type="Button" id="VerlassOpen">
                  <Label resid="ButtonLabel"/>
                  <Supertip>
                    <Title resid="ButtonLabel"/>
                    <Description resid="ButtonTip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16"/>
                    <bt:Image size="32" resid="Icon.32"/>
                    <bt:Image size="80" resid="Icon.80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="Taskpane.Url"/>
                    <SupportsPinning>true</SupportsPinning>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
        <MobileFormFactor>
          <ExtensionPoint xsi:type="MobileMessageReadCommandSurface">
            <Group id="VerlassMobileGroup">
              <Label resid="GroupLabel"/>
              <Control xsi:type="MobileButton" id="VerlassMobileOpen">
                <Label resid="ButtonLabel"/>
                <Icon xsi:type="bt:MobileIconList">
                  <bt:Image size="25" scale="1" resid="Icon.25"/>
                  <bt:Image size="25" scale="2" resid="Icon.50"/>
                  <bt:Image size="25" scale="3" resid="Icon.75"/>
                  <bt:Image size="32" scale="1" resid="Icon.32"/>
                  <bt:Image size="32" scale="2" resid="Icon.64"/>
                  <bt:Image size="32" scale="3" resid="Icon.96"/>
                  <bt:Image size="48" scale="1" resid="Icon.48"/>
                  <bt:Image size="48" scale="2" resid="Icon.96"/>
                  <bt:Image size="48" scale="3" resid="Icon.144"/>
                </Icon>
                <Action xsi:type="ShowTaskpane">
                  <SourceLocation resid="Taskpane.Url"/>
                </Action>
              </Control>
            </Group>
          </ExtensionPoint>
        </MobileFormFactor>
        </Host>
      </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16" DefaultValue="https://verlass.alyssaagard.dev/assets/icons/icon-16.png"/>
        <bt:Image id="Icon.32" DefaultValue="https://verlass.alyssaagard.dev/assets/icons/icon-32.png"/>
        <bt:Image id="Icon.80" DefaultValue="https://verlass.alyssaagard.dev/assets/icons/icon-80.png"/>
        <bt:Image id="Icon.25" DefaultValue="https://verlass.alyssaagard.dev/assets/icons/icon-25.png"/>
        <bt:Image id="Icon.50" DefaultValue="https://verlass.alyssaagard.dev/assets/icons/icon-50.png"/>
        <bt:Image id="Icon.75" DefaultValue="https://verlass.alyssaagard.dev/assets/icons/icon-75.png"/>
        <bt:Image id="Icon.64" DefaultValue="https://verlass.alyssaagard.dev/assets/icons/icon-64.png"/>
        <bt:Image id="Icon.96" DefaultValue="https://verlass.alyssaagard.dev/assets/icons/icon-96.png"/>
        <bt:Image id="Icon.48" DefaultValue="https://verlass.alyssaagard.dev/assets/icons/icon-48.png"/>
        <bt:Image id="Icon.144" DefaultValue="https://verlass.alyssaagard.dev/assets/icons/icon-144.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Taskpane.Url" DefaultValue="https://verlass.alyssaagard.dev/app/outlook.html"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GroupLabel" DefaultValue="Verlass"/>
        <bt:String id="ButtonLabel" DefaultValue="Help desk"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="ButtonTip" DefaultValue="Send a request to the help desk, follow your requests, and work the team's queue."/>
      </bt:LongStrings>
    </Resources>
    </VersionOverrides>
  </VersionOverrides>
</OfficeApp>
